#!/usr/bin/env bash
# Packages the native binary that passed the browser test (CI's native job, handed over as an
# artifact) and pushes it to zot, so the image that ships is the binary CI tested (no separate
# release build). Runs in ci.yml's publish job on the homelab ARC runner, after the workflow has
# logged in to zot with the JWT-SVID spiffe://ddupan.top/ci/github/ddupan/iam-login/ci.
set -euo pipefail

repo=zot.lab.ddupan.top/iam/iam-login
tag=${GITHUB_SHA:?}

docker build -q -t "$repo:$tag" .
docker push -q "$repo:$tag" >/dev/null
echo "Published $repo:$tag"
